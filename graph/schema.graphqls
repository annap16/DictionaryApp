type Word {
  id: ID!
  word: String!
  translations: [Translation!]!
}

type Translation {
  id: ID!
  translation: String!
  exampleSentences: [ExampleSentence!]!
}

type ExampleSentence {
  id: ID!
  sentence: String!
}

input CreateTranslationInput {
  word: String!
  translation: String!
  examples: [String!]
}

type Query {
  getWordID(word: String!): Int!
  getTranslationID(translation: String!): Int!
  getWordTranslation(word: String, id: ID): [Translation!]!
  getExamples(translation: String, id: ID): [ExampleSentence!]!
}

type Mutation {
  createTranslation(input: CreateTranslationInput!): Word!
}
